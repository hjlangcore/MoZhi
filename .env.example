# 墨智 MoZhi 环境配置示例

# 应用设置
APP_NAME="墨智 MoZhi"
DEBUG=false

# 安全密钥 - 生产环境必须修改！
# 生成方法：openssl rand -hex 32
SECRET_KEY=""

# 数据库
DATABASE_URL="sqlite:///./mozhi.db"

# Ollama LLM 配置
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"
OLLAMA_TIMEOUT=120

# 日志配置
LOG_LEVEL="INFO"
LOG_ROTATION="100 MB"
LOG_RETENTION="7 days"

# CORS 配置
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# SSRF 防护
ENABLE_SSRF_PROTECTION=true
ALLOWED_URL_SCHEMES='["http","https"]'

# 代理配置（默认禁用）
PROXY_ENABLED=false
PROXY_URL=""
SECRET_KEY=7ZaOCEHWApBFV_RPDR86oXSINheTJ_E4nS3ma3xsXpA
