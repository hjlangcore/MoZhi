APP_NAME=Fusion Project
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=sqlite:///./fusion_project.db

# 本地 LLM 配置 (Ollama)
# 4G 显存推荐: qwen2.5:3b (首选) 或 qwen2.5:7b (GPU+CPU混合)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

LOG_LEVEL=INFO

MAX_CHAPTER_WORDS=5000
MIN_CHAPTER_WORDS=1000
DEFAULT_CHAPTER_WORDS=2000

SESSION_EXPIRE_HOURS=72

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 联网搜索配置
NETWORK_TIMEOUT=30
NETWORK_MAX_RETRIES=3
NETWORK_REQUEST_INTERVAL=5
NETWORK_VERIFY_SSL=true

# 代理配置 (Clash/机场)
PROXY_ENABLED=true
PROXY_URL=http://127.0.0.1:7890
